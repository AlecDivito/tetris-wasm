{
  "name": "web-tetris-frontend",
  "version": "0.1.0",
  "description": "Easily implement a game of tetris anywhere on the web",
  "main": "src/index.ts",
  "type": "module",
  "bin": {
    "create-wasm-app": ".bin/create-wasm-app.js"
  },
  "scripts": {
    "watch": "webpack --config webpack/webpack.dev.js --watch",
    "build": "webpack --config webpack/webpack.prod.js",
    "start": "webpack serve --port 9966 --hot --config webpack/webpack.dev.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rustwasm/create-wasm-app.git"
  },
  "keywords": [
    "webassembly",
    "wasm",
    "rust",
    "webpack"
  ],
  "author": "Alec Di Vito <divito.alec@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rustwasm/create-wasm-app/issues"
  },
  "homepage": "https://github.com/rustwasm/create-wasm-app#readme",
  "devDependencies": {
    "@wasm-tool/wasm-pack-plugin": "^1.7.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "esbuild-loader": "^4.5.0",
    "hello-wasm-pack": "^0.1.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "sass": "^1.102.0",
    "sass-loader": "^17.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^7.0.2",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "pocketbase": "^0.27.1"
  }
}
